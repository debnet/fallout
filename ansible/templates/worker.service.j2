[Unit]
Description=Fallout RPG Celery worker
After=network.target {{ fallout_postgres_service }}.service fallout-redis.service
Requires=fallout-redis.service

[Service]
User=fallout
Group=fallout
WorkingDirectory={{ fallout_home }}
EnvironmentFile=/etc/fallout/environment
ExecStart={{ fallout_root }}/current/venv/bin/celery -A rpg.celery:app worker --loglevel=INFO --concurrency={{ fallout_celery_concurrency }}
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
KillSignal=SIGTERM
KillMode=mixed
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ fallout_home }}
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
