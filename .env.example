# Generate each secret independently: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=
# URL-safe password (letters, digits, - and _); not a reused application secret.
POSTGRES_PASSWORD=
# Required only for the first initialization; validated with Django's password validators.
FALLOUT_ADMIN_PASSWORD=
DJANGO_ALLOWED_HOSTS=rpg.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://rpg.example.org
HTTP_PORT=8080
